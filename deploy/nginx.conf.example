# 前后端分离、同域部署示例：nginx 托管 Vue 构建产物（web/dist），并把 /api、/files 反向代理到 Go 服务。
# Same-origin split deployment: nginx serves the Vue build (web/dist) and proxies /api and /files to the Go server.
# Go 配置：server.web_dir 留空，server.trust_proxy: true，addr 建议只监听本机（如 "127.0.0.1:8080"）。
# Go config: leave server.web_dir empty, set server.trust_proxy: true, and listen on localhost only (e.g. "127.0.0.1:8080").
# 启用 HTTPS 后同时把 auth.cookie_secure 改为 true。
# Once HTTPS is enabled, also set auth.cookie_secure to true.

upstream cw_backend {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    root /path/to/construction_warehouse/web/dist;
    index index.html;

    # 与 storage.max_import_mb 保持一致（略大一些）
    # Keep in line with storage.max_import_mb (slightly larger).
    client_max_body_size 520m;

    location /api/ {
        proxy_pass http://cw_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }

    location /files/ {
        proxy_pass http://cw_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 带 hash 的构建资源长期缓存 / hashed build assets are cached long-term
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 前端 history 路由：未知路径回退到 index.html，且不缓存 index.html
    # Frontend history routes fall back to index.html, which is never cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
